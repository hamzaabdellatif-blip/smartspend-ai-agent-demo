{
  "outputDirectory": "public",
  "buildCommand": "",
  "installCommand": "",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "/smartspend/",
      "permanent": false
    },
    {
      "source": "/egypt",
      "destination": "/smartspend/egypt/",
      "permanent": false
    },
    {
      "source": "/egypt/",
      "destination": "/smartspend/egypt/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/ziila-env.js",
      "destination": "https://ziila-ai.intella.me/env.js"
    },
    {
      "source": "/(.*)",
      "destination": "https://ziila-ai.intella.me/$1"
    }
  ]
}
